
<script src="/js/sessao/cadastrar.js"></script>
<div>
    <h1>Cadastrar Sessão</h1>
</div>

<div>
    <form>
        <div class="form-group">
            <label for="inputData">Data e Hora</label>
            <input type="datetime-local" class="form-control" id="inputData">
          </div>
        <div class="form-group">
            <label for="inputPreco">Preço</label>
            <input type="number" class="form-control" id="inputPreco">
        </div>
        <div class="form-group">
            <label for="inputFilmeId">Filme Id</label>
            <input type="number" class="form-control" id="inputFilmeId">
        </div>
        <div class="form-group">
            <label for="inputSalaId">Sala Id</label>
            <input type="number" class="form-control" id="inputSalaId">
        </div>


        <div>
            <button class="btn btn-primary" type="button" id="btnCadastrar">Gravar</button>
            <a href="/admin/sessoes" class="btn btn-default">Voltar</a>
        </div>
      </form>
</div>