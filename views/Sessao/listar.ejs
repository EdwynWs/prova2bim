  <script src="/js/sessao/listar.js"></script>

<h2>Sessões cadastradas</h2>
<a class="btn btn-primary" style="max-width: 200px;" href="/admin/sessao/cadastrar">Nova Sessão</a>

<hr>
    <div>
        <table class="table table-striped">
            <thead>
                <th>Id</th>
                <th>Data e Hora</th>
                <th>Preço</th>
                <th>Filme</th>
                <th>Sala</th>
            </thead>
            <tbody>
                <% for (let i = 0; i < listar.length; i++)  { %>
                    <tr>
                        <td><%= listar[i].id %></td>
                        <td><%= listar[i].datahora %></td>
                        <td><%= listar[i].preco %></td>
                        <td><%= listar[i].filmNome %></td>
                        <td><%= listar[i].salaNome %></td>
                        <td>
                            <button data-codigoexclusao="<%= listar[i].id %>" class="btn btn-danger btnExclusao">Excluir</button>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
