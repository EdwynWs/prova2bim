
<script src="/js/sessao/listar.js"></script>
<div>
    <h2>Sessões cadastradas</h2>
</div>

<div>
    <a style="margin-bottom: 15px !important;" href="/admin/sessoes/cadastrar" class="btn btn-primary"><i class="fas fa-plus"></i> Cadastrar filme</a>
    <div class="table-responsive">
    
        <table class="table align-items-center mb-0">
            <thead class="bg-gray-100">
                <th>Código</th>
                <th>Data e hora</th>
                <th>Preço</th>
                <th>Filme</th>
                <th>Sala</th>
            </thead>
    
            <tbody>
                <% for(let i = 0; i<lista.length; i++){ %>
                    <tr>
                        <td><%= lista[i].ses_id %></td>
                        <td><%= new Date(lista[i].ses_datahora).toLocaleString() %></td>
                        <td>R$ <%= lista[i].ses_preco %> </td>
                        <td><%= lista[i].fil_id %> </td>
                        <td><%= lista[i].sal_id %> </td>
                        <td>
                            <button data-codigoexclusao="<%= lista[i].ses_id %>" class="btn btn-danger btnExclusao">Excluir</button>
                        </td>
                    </tr>
               <%} %>
            </tbody>
        </table>
    </div>
    
</div>
