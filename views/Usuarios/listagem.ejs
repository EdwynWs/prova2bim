<script src="/js/usuarios/listagem.js"></script>

<h2>Usuários cadastrados</h2>
<a class="btn btn-primary" style="max-width: 200px;" href="/admin/usuarios/cadastrar">Novo Usuário</a>

<hr>
    <div>
        <table class="table table-striped">
            <thead>
                <th>Id</th>
                <th>Email</th>
                <th>Nome</th>
                <th>Perfil</th>
                <th>Ativo</th>
                <th>Ações</th>
            </thead>
            <tbody>
                <% for (let i = 0; i < lista.length; i++)  { %>
                    <tr>
                        <td><%= lista[i].usuarioId %></td>
                        <td><%= lista[i].usuarioEmail %></td>
                        <td><%= lista[i].usuarioNome %></td>
                        <td><%= lista[i].perfilId %></td>
                        <td><%= lista[i].usuarioAtivo %></td>
                        <td>
                            <a href="/admin/usuarios/alterar/<%= lista[i].usuarioId %>" class="btn btn-primary">Editar</a>
                            <button data-codigoexclusao="<%= lista[i].usuarioId %>" class="btn btn-danger btnExclusao">Excluir</button>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
