
<script src="/js/reserva/cadastrar.js"></script>
<div>
    <h1>Cadastrar Reserva</h1>
</div>

<div>
    <form>
        
        <div class="form-group">
            <label for="inputNome">Nome</label>
            <input type="text" class="form-control" id="inputNome">
        </div>
        <div class="form-group">
            <label for="inputEmail">Email</label>
            <input type="text" class="form-control" id="inputEmail">
        </div>
           <div class="form-group">
            <label for="inputData">Data e Hora</label>
            <input type="datetime-local" class="form-control" id="inputData">
          </div>
        <div class="form-group">
            <label for="inputAssento">Assento</label>
            <input type="number" class="form-control" id="inputAssento">
        </div>
        <div class="form-group">
            <label for="inputSessaoId">Sessão Id</label>
            <input type="number" class="form-control" id="inputSessaoId">
        </div>

        <div>
            <button class="btn btn-primary" type="button" id="btnCadastrar">Gravar</button>
            <a href="/admin/reservas" class="btn btn-default">Voltar</a>
        </div>
      </form>
</div>