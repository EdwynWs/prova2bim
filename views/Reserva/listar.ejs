<script src="/js/reserva/listar.js"></script>
<div>
    <h2>Reservas cadastradas</h2>
</div>

<div>
    <a style="margin-bottom: 15px !important;" href="/admin/reservas/cadastrar" class="btn btn-primary"><i class="fas fa-plus"></i> Cadastrar filme</a>
    <div class="table-responsive">
        <div class="form-group">
        <label>Buscar reservas :</label>
        <input type="text" id="txtBusca" class="form-control" placeholder="Digite o número do pedido ou o nome do produto">
    </div>
        <table class="table align-items-center mb-0">
            <thead class="bg-gray-100">
                <th>Id</th>
                <th>Nome</th>
                <th>Email</th>
                <th>Data e Hora</th>
                <th>Assento</th>
                <th>Sessao Id</th>
            </thead>
    
            <tbody>
                <% lista.map(function(value,index) { %>
                    <tr>
                        <td><%= value.id %></td>
                        <td>R$ <%= value.Nome %> </td>
                        <td><%= value.Email %> </td>
                        <td><%= new Date(value.dataHora).toLocaleString() %></td>
                        <td><%= value.assento %> </td>
                        <td><%= value.sessao %> </td>
                    </tr>
               <%}) %>
            </tbody>
        </table>
    </div>
    
</div>
